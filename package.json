{
  "name": "@lvntr/starter-kit",
  "description": "Vue 3 components for Lvntr Starter Kit (FormBuilder, DatatableBuilder, TabBuilder, FileManager, Skeleton, UI)",
  "type": "module",
  "scripts": {
    "lang:build": "node resources/js/lang/sk-lang-build.mjs",
    "lint:lib": "stubs/node_modules/.bin/eslint --config stubs/eslint.config.js resources/js/components/Lvntr-Starter-Kit --quiet"
  },
  "main": "resources/js/components/Lvntr-Starter-Kit/index.ts",
  "exports": {
    ".": "./resources/js/components/Lvntr-Starter-Kit/index.ts",
    "./FormBuilder": "./resources/js/components/Lvntr-Starter-Kit/FormBuilder/SkForm.vue",
    "./FormBuilder/*": "./resources/js/components/Lvntr-Starter-Kit/FormBuilder/*",
    "./DatatableBuilder": "./resources/js/components/Lvntr-Starter-Kit/DatatableBuilder/SkDatatable.vue",
    "./DatatableBuilder/*": "./resources/js/components/Lvntr-Starter-Kit/DatatableBuilder/*",
    "./FileManager": "./resources/js/components/Lvntr-Starter-Kit/FileManager/FileManager.vue",
    "./FileManager/*": "./resources/js/components/Lvntr-Starter-Kit/FileManager/*",
    "./TabBuilder": "./resources/js/components/Lvntr-Starter-Kit/TabBuilder/SkTabs.vue",
    "./TabBuilder/*": "./resources/js/components/Lvntr-Starter-Kit/TabBuilder/*",
    "./Skeleton/*": "./resources/js/components/Lvntr-Starter-Kit/Skeleton/*",
    "./ui/*": "./resources/js/components/Lvntr-Starter-Kit/ui/*",
    "./*": "./resources/js/components/Lvntr-Starter-Kit/*"
  },
  "files": [
    "resources/js/components",
    "resources/js/theme",
    "resources/js/lang"
  ],
  "keywords": [
    "vue",
    "primevue",
    "form-builder",
    "datatable",
    "starter-kit",
    "laravel"
  ],
  "license": "MIT"
}
