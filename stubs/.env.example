APP_NAME="LVNTR LARAVEL STARTER KIT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://local-test.test

# ---- Encryption ----
# Dedicated key for sensitive settings (settings.value) and 2FA secrets.
# `php artisan key:generate` neither creates NOR overwrites this key; it must be
# carried together with .env on a server migration (see docs/server-migration-runbook.md).
DATA_ENCRYPTION_KEY=
# Previous key(s) during rotation, comma-separated — cleared only after
# `encryption:rekey` finishes and `encryption:health` reports OK.
DATA_ENCRYPTION_PREVIOUS_KEYS=

# Data is always stored in UTC. Do not change this; changing it makes stored timestamps ambiguous.
APP_TIMEZONE=UTC
# Fallback display timezone. The admin panel's General settings override it, and each user can override that.
APP_DISPLAY_TIMEZONE=UTC

APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# Unique per app. sk:install auto-fills this so two kit apps sharing one Redis
# don't collide on cache keys (settings, definitions, sessions). Set your own to override.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# TURNSTILE_ENABLED=false
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# STARTER_KIT_DATATABLE_PER_PAGE=10
# STARTER_KIT_DATATABLE_MAX_PER_PAGE=100

# Deny a request whose permission cannot be derived from its route name at all,
# instead of letting it reach the controller ungated with a logged warning.
# Seeded as false for a NEW project on purpose: a fresh app has no legacy route
# to grandfather in, so there is no reason to start permissive. If a route of
# yours starts returning 403, `php artisan sk:doctor --only=unresolved-routes`
# names it and docs/UPGRADE.md lists the three ways to fix it — give it a
# <resource>.<action> name, gate it with check.permission:<permission>, or
# declare it under starter-kit.permissions.unrestricted_routes. Setting this to
# true restores the kit's own default and is a supported choice.
STARTER_KIT_ALLOW_UNRESOLVED_ROUTES=false

VITE_APP_NAME="${APP_NAME}"
